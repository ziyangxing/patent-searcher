# LLM
LLM_PROVIDER=openai
LLM_MODEL=gpt-4o
OPENAI_API_KEY=
OPENAI_BASE_URL=
ANTHROPIC_API_KEY=

# Embedding
EMBEDDING_MODEL=all-MiniLM-L6-v2
EMBEDDING_DEVICE=cpu

# Elasticsearch
ES_HOST=http://localhost:9200
ES_INDEX_NAME=patents

# PostgreSQL
DATABASE_URL=postgresql+asyncpg://patent:patent123@localhost:5432/patent_search

# Redis
REDIS_URL=redis://localhost:6379

# Patent APIs
EPO_OPS_KEY=
EPO_OPS_SECRET=
# Get free key at https://serpapi.com (100 searches/month)
SERPAPI_KEY=

# File Storage
UPLOAD_DIR=./uploads
MAX_UPLOAD_SIZE=52428800

# FAISS
FAISS_INDEX_PATH=./data/faiss_index.bin
FAISS_DIM=384
